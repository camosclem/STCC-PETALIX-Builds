<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-feature android:name="android.software.leanback" android:required="false"/>
    <uses-feature android:name="android.hardware.touchscreen" android:required="false"/>
    <queries>
        <package android:name="com.netflix.ninja"/>
        <package android:name="com.amazon.amazonvideo.livingroom"/>
        <package android:name="com.disney.disneyplus"/>
        <package android:name="com.hulu.livingroomplus"/>
        <package android:name="com.britbox.us"/>
    </queries>
    <application android:label="Petalix TV Preview" android:banner="@drawable/tv_banner" android:usesCleartextTraffic="true" android:allowBackup="false" android:theme="@android:style/Theme.Material.NoActionBar">
        <activity android:name=".GuideActivity" android:exported="true" android:configChanges="orientation|screenSize|screenLayout|keyboardHidden" android:resizeableActivity="true">
            <intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/><category android:name="android.intent.category.LEANBACK_LAUNCHER"/></intent-filter>
        </activity>
    </application>
</manifest>
