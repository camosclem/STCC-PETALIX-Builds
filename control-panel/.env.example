# Use cryptographically random values and HTTPS in deployment. Never commit a real .env file.
PETALIX_ADMIN_KEY=replace-with-at-least-24-random-characters
PETALIX_PIN_SECRET=replace-with-at-least-32-random-characters
PETALIX_FERNET_KEY=generate-with-python-cryptography-fernet
PETALIX_DB_PATH=/var/lib/petalix-control/petalix-beta.sqlite3
