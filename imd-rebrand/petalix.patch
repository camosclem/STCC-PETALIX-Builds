@@ -0,0 +1,36 @@
+package org.imdtv.iptvtv.ui.settings
+
+import androidx.compose.runtime.*
+import androidx.compose.ui.platform.LocalContext
+import androidx.compose.ui.text.input.KeyboardType
+import kotlinx.coroutines.CancellationException
+import kotlinx.coroutines.launch
+import org.imdtv.iptvtv.IptvApp
+import org.imdtv.iptvtv.data.petalix.PetalixSetupError
+
+@Composable
+fun PetalixZipRow() {
+    val account = (LocalContext.current.applicationContext as IptvApp).container.petalixAccount
+    val scope = rememberCoroutineScope()
+    var status by remember { mutableStateOf("Find local stations from your playlist") }
+    var busy by remember { mutableStateOf(false) }
+    var zip by remember { mutableStateOf(account.zipCode) }
+    EditRow("Local channels ZIP code", status, zip.ifEmpty { null }, zip, keyboard = KeyboardType.Number, saveLabel = "Find locals") { value ->
+        if (!busy) scope.launch {
+            busy = true
+            status = "Finding stations…"
+            try {
+                status = account.findLocals(value)
+                zip = account.zipCode
+            } catch (e: CancellationException) {
+                throw e
+            } catch (e: PetalixSetupError) {
+                status = e.message.orEmpty()
+            } catch (_: Exception) {
+                status = "Could not look up local stations. Try again."
+            } finally {
+                busy = false
+            }
+        }
+    }
+}
