diff --git a/app/src/main/java/org/imdtv/iptvtv/data/petalix/PetalixAccount.kt b/app/src/main/java/org/imdtv/iptvtv/data/petalix/PetalixAccount.kt
new file mode 100644
index 0000000..bc30aae
--- /dev/null
+++ b/app/src/main/java/org/imdtv/iptvtv/data/petalix/PetalixAccount.kt
@@ -0,0 +1,202 @@
+package org.imdtv.iptvtv.data.petalix
+
+import android.os.Build
+import androidx.room.withTransaction
+import java.io.IOException
+import java.time.Instant
+import java.util.Locale
+import java.util.UUID
+import kotlin.math.*
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.flow.first
+import kotlinx.coroutines.sync.Mutex
+import kotlinx.coroutines.sync.withLock
+import kotlinx.coroutines.withContext
+import okhttp3.HttpUrl.Companion.toHttpUrl
+import okhttp3.MediaType.Companion.toMediaType
+import okhttp3.Request
+import okhttp3.RequestBody.Companion.toRequestBody
+import org.imdtv.iptvtv.AppContainer
+import org.imdtv.iptvtv.BuildConfig
+import org.imdtv.iptvtv.data.db.ChannelEntity
+import org.imdtv.iptvtv.data.db.GroupPlacement
+import org.imdtv.iptvtv.data.db.ProviderEntity
+import org.imdtv.iptvtv.data.db.ProviderType
+import org.imdtv.iptvtv.data.model.Kind
+import org.imdtv.iptvtv.data.model.StreamFormat
+import org.imdtv.iptvtv.data.security.Secrets
+import org.json.JSONArray
+import org.json.JSONObject
+
+class PetalixSetupError(message: String) : IOException(message)
+
+class PetalixAccount(private val app: AppContainer) {
+    private val prefs = app.appContext.getSharedPreferences("petalix_imd_preview", 0)
+    private val lock = Mutex()
+    private val groupLock = Mutex()
+    private val client by lazy { app.http.newBuilder().followRedirects(false).followSslRedirects(false).build() }
+
+    val canResume: Boolean get() = prefs.contains("activation")
+    val zipCode: String get() = prefs.getString("zip", "").orEmpty()
+
+    suspend fun connect(pin: String?, progress: (String) -> Unit): String = withContext(Dispatchers.IO) {
+        lock.withLock {
+            val account = if (pin == null) {
+                val token = Secrets.decrypt(prefs.getString("activation", null))
+                    ?: throw PetalixSetupError("Enter the PIN for this preview device.")
+                post("status", null, token)
+            } else {
+                if (!pin.matches(Regex("[0-9]{8}"))) throw PetalixSetupError("Enter an 8-digit PIN.")
+                post("activate", pin, null).also { response ->
+                    val token = response.optString("token")
+                    if (token.isBlank()) throw PetalixSetupError("Petalix Control did not return a session.")
+                    val encrypted = Secrets.encrypt(token)
+                    if (!Secrets.isEncrypted(encrypted) || !prefs.edit().putString("activation", encrypted).commit()) {
+                        throw PetalixSetupError("Could not save the preview activation on this device.")
+                    }
+                }
+            }
+            val expiry = account.optString("expires").takeIf(String::isNotBlank)
+            if (expiry != null && Instant.parse(expiry).toEpochMilli() <= System.currentTimeMillis()) {
+                throw PetalixSetupError("This Petalix account has expired.")
+            }
+            val old = prefs.getLong("playlist", -1L).takeIf { it > 0 }?.let { app.db.providerDao().get(it) }
+            val raw = account.optString("server").trim()
+            val user = account.optString("username")
+            val password = account.optString("password")
+            val available = raw.isNotEmpty() && user.isNotEmpty() && password.isNotEmpty()
+            val provider = if (!available) old ?: throw PetalixSetupError("This account has no playlist assigned in Petalix Control.")
+            else {
+                val normalized = (if ("://" in raw) raw else "http://$raw").toHttpUrl()
+                if (normalized.username.isNotEmpty() || normalized.password.isNotEmpty()) {
+                    throw PetalixSetupError("Petalix Control returned an invalid provider address.")
+                }
+                val base = normalized.newBuilder().encodedPath("/").query(null).fragment(null).build().toString().trimEnd('/')
+                old?.copy(url = base, username = user, password = password) ?: ProviderEntity(
+                    name = "Petalix", type = ProviderType.XTREAM, url = base, username = user, password = password,
+                    userAgent = null, streamFormat = StreamFormat.TS, epgOverrideUrls = emptyList(), lastSync = null,
+                )
+            }
+            val id = if (old == null) app.providerRepository.add(provider).also {
+                check(prefs.edit().putLong("playlist", it).commit())
+            } else old.id
+            if (old != null && old != provider) app.providerRepository.update(provider)
+            val result = try {
+                app.providerRepository.syncNow(id, progress)
+            } catch (error: Exception) {
+                if (old != null && old != provider) app.providerRepository.update(old)
+                throw error
+            }
+            app.providerRepository.setActive(id)
+            "${result.channels} channels · ${result.movies} movies · ${result.series} series. The TV guide is loading."
+        }
+    }
+
+    private fun post(action: String, pin: String?, token: String?): JSONObject {
+        val base = "petalix-control.caroliinaconsultant.chatgpt.site"
+        val officialHosts = setOf(base, "petalix-control.pinkgiant5.chatgpt.site")
+        val route = "/api/device/$action"
+        var endpoint = "https://$base$route".toHttpUrl()
+        val id = prefs.getString("device", null) ?: UUID.randomUUID().toString().also {
+            check(prefs.edit().putString("device", it).commit())
+        }
+        val report = JSONObject().put("deviceId", id).put("brand", "petalix")
+            .put("label", "${Build.MANUFACTURER} ${Build.MODEL} (Petalix IMD Preview)")
+            .put("packageName", BuildConfig.APPLICATION_ID).put("clientVersion", BuildConfig.VERSION_NAME)
+            .put("clientBuild", BuildConfig.VERSION_CODE).put("capabilities", JSONArray().put("panel-session-origin-v1"))
+        if (pin != null) report.put("code", pin)
+        val body = report.toString().toRequestBody("application/json".toMediaType())
+        repeat(3) {
+            val request = Request.Builder().url(endpoint).post(body)
+            if (token != null) request.header("Authorization", "Bearer $token")
+            client.newCall(request.build()).execute().use { response ->
+                if (response.code in setOf(301, 302, 303, 307, 308)) {
+                    val next = response.header("Location")?.let(endpoint::resolve)
+                    if (next == null || !next.isHttps || next.port != 443 || next.host !in officialHosts ||
+                        next.username.isNotEmpty() || next.password.isNotEmpty() || next.encodedPath != route ||
+                        next.query != null || next.fragment != null) {
+                        throw PetalixSetupError("Petalix Control returned an unrecognized address.")
+                    }
+                    endpoint = next
+                } else {
+                    if (response.code == 401 || response.code == 403) {
+                        if (token != null) prefs.edit().remove("activation").apply()
+                        throw PetalixSetupError("Activation was declined. Check the PIN and available device slots in Petalix Control.")
+                    }
+                    if (!response.isSuccessful) throw PetalixSetupError("Petalix Control could not complete the request (${response.code}).")
+                    return JSONObject(response.body?.string().orEmpty())
+                }
+            }
+        }
+        throw PetalixSetupError("Petalix Control redirected too many times.")
+    }
+
+    suspend fun findLocals(zip: String): String = withContext(Dispatchers.IO) {
+        lock.withLock {
+            if (!zip.matches(Regex("[0-9]{5}"))) throw PetalixSetupError("Enter a 5-digit ZIP code.")
+            val provider = app.providerRepository.activeProviderId.first()
+                ?: throw PetalixSetupError("Load a playlist before finding local channels.")
+            val request = Request.Builder().url("https://api.zippopotam.us/us/$zip").build()
+            val place = app.http.newCall(request).execute().use { response ->
+                if (response.code == 404) throw PetalixSetupError("ZIP code not found.")
+                if (!response.isSuccessful) throw PetalixSetupError("ZIP lookup is temporarily unavailable.")
+                JSONObject(response.body?.string().orEmpty()).getJSONArray("places").getJSONObject(0)
+            }
+            val lat = Math.toRadians(place.getDouble("latitude"))
+            val lon = Math.toRadians(place.getDouble("longitude"))
+            val stations = app.appContext.assets.open("local-stations.json").bufferedReader().use {
+                JSONObject(it.readText()).getJSONArray("stations")
+            }
+            val calls = mutableSetOf<String>()
+            for (index in 0 until stations.length()) {
+                val station = stations.getJSONObject(index)
+                val y = Math.toRadians(station.getDouble("lat"))
+                val x = Math.toRadians(station.getDouble("lon"))
+                val arc = sin(lat) * sin(y) + cos(lat) * cos(y) * cos(lon - x)
+                if (acos(arc.coerceIn(-1.0, 1.0)) * 3959 <= 90) {
+                    calls += station.getString("call").uppercase(Locale.US).substringBefore('-')
+                }
+            }
+            val matches = app.db.channelDao().byProvider(provider).filter { channel ->
+                !channel.hidden && "${channel.name} ${channel.tvgId.orEmpty()}".uppercase(Locale.US)
+                    .split(CALL_SEPARATOR).any { it in calls }
+            }
+            if (matches.isEmpty()) throw PetalixSetupError("No local channels for $zip were found in this playlist.")
+            saveGroup(provider, "My Locals", matches)
+            prefs.edit().putString("zip", zip).apply()
+            "${matches.size} channels in My Locals"
+        }
+    }
+
+    suspend fun updateSports(provider: Long) {
+        val categories = app.db.categoryDao().all(provider, Kind.LIVE).associate { it.id to it.name }
+        val channels = app.db.channelDao().byProvider(provider).filter {
+            !it.hidden && SPORT.containsMatchIn("${categories[it.categoryId].orEmpty()} ${it.name}")
+        }
+        if (channels.isNotEmpty()) saveGroup(provider, "Sports Hub", channels)
+    }
+
+    private suspend fun saveGroup(provider: Long, title: String, matches: List<ChannelEntity>) = groupLock.withLock {
+        val prefsKey = "group:$provider:$title"
+        val dao = app.db.customGroupDao()
+        val tracked = prefs.getLong(prefsKey, -1L)
+        val group = app.db.withTransaction {
+            val id = dao.observe(provider).first().firstOrNull { it.id == tracked && it.name == title }?.id
+                ?: dao.create(provider, title)
+            dao.setPlacement(id, GroupPlacement.TOP)
+            val existing = dao.memberRemoteIds(id).toSet()
+            val wanted = matches.mapTo(HashSet()) { it.remoteId }
+            app.db.channelDao().remoteIds(provider).filter { it.remoteId in existing && it.remoteId !in wanted }
+                .forEach { dao.removeChannel(id, it.id) }
+            matches.sortedWith(compareBy(String.CASE_INSENSITIVE_ORDER) { it.name }).forEach { dao.addChannel(id, it.id) }
+            id
+        }
+        prefs.edit().putLong(prefsKey, group).apply()
+        Unit
+    }
+
+    private companion object {
+        val CALL_SEPARATOR = Regex("[^A-Z0-9]+")
+        val SPORT = Regex("""\b(sports?|nfl|nba|wnba|mlb|nhl|ncaa|ncaaf|ncaab|soccer|football|basketball|baseball|hockey|ufc|ppv|espn|tsn|fanduel|tennis|golf|fubo|f1|nascar|bein|dazn)\b""", RegexOption.IGNORE_CASE)
+    }
+}
