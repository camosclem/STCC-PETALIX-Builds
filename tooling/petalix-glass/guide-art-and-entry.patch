 private fun homeArtworkUri(name: String) = "file:///android_asset/petalix/home-art/$name.webp"
+
+/** The same artwork used on Home's service tiles, including the bundled fallback. */
+internal fun petalixServiceHeroArtwork(folderId: String, configuredArtwork: Map<String, String>): String? {
+    configuredArtwork[folderId]?.let { return it }
+    val artwork = petalixServiceArtworkUri(folderId) ?: return null
+    return if (artwork.startsWith("https://art.kaptain.stream/"))
+        "file:///android_asset/petalix/service-art-v1/$folderId.jpg" else artwork
+}
