+@Composable
+internal fun PetalixGuideLogo(
+    channel: LiveChannel, width: Dp, height: Dp, modifier: Modifier = Modifier,
+    onAvailability: (Boolean) -> Unit = {},
+) {
+    val candidates = remember(channel.logo, channel.guideLogoFallbacks) {
+        (listOfNotNull(channel.logo) + channel.guideLogoFallbacks).distinct().filter {
+            it.isNotBlank() && !DeadLogos.isDead(it)
+        }
+    }
+    var index by remember(candidates) { mutableIntStateOf(0) }
+    val url = candidates.getOrNull(index)
+    var visible by remember(url) { mutableStateOf(false) }
+    LaunchedEffect(visible) { onAvailability(visible) }
+    if (url == null) return
+
+    val context = LocalContext.current
+    val revalidation = com.nuvio.tv.core.image.rememberImageRevalidationKey(url)
+    val request = remember(context, url, revalidation) {
+        ImageRequest.Builder(context).data(url)
+            .memoryCacheKey("$url:petalix-guide-logo:$revalidation")
+            .size(192, 104).scale(Scale.FIT).precision(Precision.INEXACT).build()
+    }
+    Box(
+        modifier.size(width, height).clip(RoundedCornerShape(7.dp))
+            .background(if (visible) Color(0xFF222225) else Color.Transparent),
+        contentAlignment = Alignment.Center,
+    ) {
+        AsyncImage(
+            model = request, contentDescription = null, contentScale = ContentScale.Fit,
+            modifier = Modifier.fillMaxSize().padding(horizontal = 4.dp, vertical = 3.dp),
+            alpha = if (visible) 1f else 0f,
+            onSuccess = {
+                val image = it.result.image
+                if (image.width >= 64 && image.height >= 16) visible = true else index++
+            },
+            onError = {
+                DeadLogos.failed(url, it.result.throwable)
+                index++
+            },
+        )
+    }
+}
+
+@Composable
+internal fun PetalixGuideProgramArt(candidates: List<String>, modifier: Modifier = Modifier) {
+    var index by remember(candidates) { mutableIntStateOf(0) }
+    val url = candidates.getOrNull(index) ?: return
+    var artworkType by remember(url) { mutableStateOf<PetalixGuideArtworkType?>(null) }
+    val context = LocalContext.current
+    val revalidation = com.nuvio.tv.core.image.rememberImageRevalidationKey(url)
+    val request = remember(context, url, revalidation) {
+        ImageRequest.Builder(context).data(url)
+            .memoryCacheKey("$url:petalix-guide-art:$revalidation")
+            .size(1280, 720).scale(Scale.FIT).precision(Precision.INEXACT).build()
+    }
+    Box(modifier, contentAlignment = Alignment.CenterEnd) {
+        val landscape = artworkType == PetalixGuideArtworkType.LANDSCAPE
+        val artModifier = if (landscape) {
+            Modifier.fillMaxSize()
+                .clip(RoundedCornerShape(bottomStart = 16.dp))
+                .graphicsLayer { compositingStrategy = CompositingStrategy.Offscreen }
+                .drawWithCache {
+                    val left = Brush.horizontalGradient(0f to Color.Transparent, .44f to Color.Black)
+                    val bottom = Brush.verticalGradient(.61f to Color.Black, 1f to Color.Transparent)
+                    onDrawWithContent {
+                        drawContent()
+                        drawRect(left, blendMode = BlendMode.DstIn)
+                        drawRect(bottom, blendMode = BlendMode.DstIn)
+                    }
+                }
+        } else {
+            Modifier.padding(end = 28.dp, top = 12.dp, bottom = 16.dp)
+                .fillMaxHeight().fillMaxWidth(.42f).clip(RoundedCornerShape(12.dp))
+        }
+        AsyncImage(
+            model = request, contentDescription = null, modifier = artModifier,
+            contentScale = if (landscape) ContentScale.Crop else ContentScale.Fit,
+            alpha = if (artworkType != null) 1f else 0f,
+            onSuccess = {
+                val image = it.result.image
+                val type = petalixGuideArtworkType(image.width, image.height)
+                if (type == null) index++ else artworkType = type
+            },
+            onError = { index++ },
+        )
+    }
+}
