+package com.nuvio.tv.petalix
+
+private val tmdbImageSize = Regex("""^https://image\.tmdb\.org/t/p/(w\d+|original)(?=/)""")
+
+/** Upgrade known TMDB variants without changing the title, provider, or user-selected artwork. */
+internal fun petalixArtwork(url: String?, width: Int): String? {
+    val image = url?.takeIf { it.isNotBlank() } ?: return null
+    val match = tmdbImageSize.find(image) ?: return image
+    val variant = match.groups[1] ?: return image
+    val currentWidth = variant.value.removePrefix("w").toIntOrNull() ?: return image
+    return if (currentWidth < width) image.replaceRange(variant.range, "w$width") else image
+}
+
+internal enum class PetalixGuideArtworkType {
+    LANDSCAPE, POSTER
+}
+
+/** Tiny EPG icons shouldn't be expanded across the preview area. */
+internal fun petalixGuideArtworkType(width: Int, height: Int): PetalixGuideArtworkType? = when {
+    width >= 560 && height >= 270 && width >= height * 1.3f -> PetalixGuideArtworkType.LANDSCAPE
+    width >= 180 && height >= 270 && width < height -> PetalixGuideArtworkType.POSTER
+    else -> null
+}
