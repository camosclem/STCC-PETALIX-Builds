     !sportsGroup.containsMatchIn(group) && !sportsFeed.containsMatchIn(name)
+
+private val localGroup = Regex("""(?i)\b(?:locals?|local stations|local tv|ota|affiliates?)\b""")
+private val localNetwork = Regex("""(?i)\b(?:abc|cbs|nbc|fox|pbs|cw|ion|telemundo|univision|myp9|my network)\b""")
+private val callSign = Regex("""\b[WK][A-Z]{2,3}(?:[- ](?:TV|DT|LD|CD|LP))?\b""")
+
+/** Use explicit ZIP choices when present. Otherwise My Locals reflects the affiliates favorited in the guide. */
+internal fun petalixLocalsGroup(
+    channels: List<LiveChannel>,
+    groups: List<CustomGroup>,
+    favorites: List<String>,
+): CustomGroup? {
+    groups.firstOrNull { it.id == PETALIX_ZIP_LOCALS && it.channelKeys.isNotEmpty() }?.let { return it }
+    if (favorites.isEmpty()) return null
+    val favoriteKeys = favorites.toHashSet()
+    val localKeys = channels.asSequence().filter { channel ->
+        channel.key in favoriteKeys &&
+            petalixLocalStationCandidate(channel.name, channel.group) &&
+            (localGroup.containsMatchIn(channel.group) ||
+                (localNetwork.containsMatchIn(channel.name) &&
+                    callSign.containsMatchIn(listOfNotNull(channel.name, channel.tvgName, channel.tvgId).joinToString(" "))))
+    }.map { it.key }.distinct().toList()
+    return if (localKeys.isEmpty()) null else CustomGroup(PETALIX_ZIP_LOCALS, "My Locals", localKeys)
+}
