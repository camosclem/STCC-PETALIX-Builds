+        private const val AFCON_QUAL = "soccer/caf.nations_qual"
+        /** AFCON 2027's hosts: in the finals whatever happens. Update when the next finals' qualifiers start. */
+        private val AFCON_HOSTS = setOf("kenya", "tanzania", "uganda")
