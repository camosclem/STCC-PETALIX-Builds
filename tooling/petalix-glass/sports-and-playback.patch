+                    sameTeam(ev.away, teams?.optJSONObject("away")?.optJSONObject("team")?.optString("name"), null) &&
+                    sameTeam(ev.home, teams?.optJSONObject("home")?.optJSONObject("team")?.optString("name"), null)
